import Mathlib

/-!
# Cube-free sets and layers in `ZMod (2^n)`

The mission's one definition item, uploaded whole as the module
`Definitions.Def_Z2nCubeFreeLayers`. Each declaration states its own binders,
because the upload drops `variable` lines.
-/

namespace Z2nFiveEighths

/-- `HasCube A` says some triple `x, y, z` has all seven of its nonzero subset
sums inside `A`. The triple is unconstrained, so `x = y = z = 0` is allowed. -/
def HasCube {G : Type*} [AddCommGroup G] (A : Finset G) : Prop :=
  ∃ x y z : G, x ∈ A ∧ y ∈ A ∧ z ∈ A ∧
    x + y ∈ A ∧ y + z ∈ A ∧ z + x ∈ A ∧ x + y + z ∈ A

/-- The hypothesis of the problem, the negation of `HasCube`. -/
def CubeFree {G : Type*} [AddCommGroup G] (A : Finset G) : Prop := ¬ HasCube A

/-- The forbidden configuration generated by `x`, `y`, `z`. As a `Finset` it
holds fewer than seven elements whenever two of the seven sums coincide. -/
def config {G : Type*} [AddCommMonoid G] [DecidableEq G] (x y z : G) : Finset G :=
  {x, y, z, x + y, y + z, z + x, x + y + z}

/-- No triple `x, y, z`, distinct or not, has its whole `config` inside `A`. -/
def ConfigFree {G : Type*} [AddCommMonoid G] [DecidableEq G] (A : Finset G) :
    Prop := ∀ x y z : G, ¬ config x y z ⊆ A

/-- The layer index of a residue mod `2^n`: `v₂(x) + 1`, or `n + 1` at zero. -/
noncomputable def layerIdx (n : ℕ) (x : ZMod (2 ^ n)) : ℕ :=
  if x = 0 then n + 1 else padicValNat 2 x.val + 1

/-- `A` is a union of layers: if it meets a layer, it contains the whole layer. -/
def IsLayerUnion (n : ℕ) (A : Finset (ZMod (2 ^ n))) : Prop :=
  ∀ x y : ZMod (2 ^ n), x ∈ A → layerIdx n x = layerIdx n y → y ∈ A

end Z2nFiveEighths
